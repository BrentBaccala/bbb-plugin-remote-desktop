[Unit]
Description=WebSocket proxy for BigBlueButton VNC service
Requires=network.target

[Service]
Type=simple
WorkingDirectory=/usr/share/bbb-wss-proxy
EnvironmentFile=/etc/default/bbb-wss-proxy
ExecStart=/usr/share/bbb-wss-proxy/bin/bbb-wss-proxy
TimeoutStopSec=5

# Run as the bigbluebutton user — consistent with the rest of BBB,
# no privilege beyond what's needed for an outbound HTTP call to
# bbb-web and a TCP connection to the VNC backend. If the VNC
# target requires privileged access (Unix-socket VNC owned by
# another user, for example), drop a systemd override that sets
# User=root.
User=bigbluebutton
Group=bigbluebutton

[Install]
WantedBy=multi-user.target
