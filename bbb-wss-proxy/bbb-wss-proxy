#!/usr/bin/python3

# Authenticating WebSocket-to-VNC proxy for BigBlueButton.
#
# Wraps websockify with a session-token check: an incoming connection
# must carry a BigBlueButton session token as ?sessionToken=... in
# the WebSocket URL, and that token must validate against bbb-web's
# /bigbluebutton/api/enter endpoint before the proxy relays to a
# backend VNC server.
#
# This pairs with bbb-plugin-remote-desktop, which appends
# ?sessionToken=<token> to every WebSocket URL via the BBB plugin
# SDK's getSessionToken(). Any BBB user authenticated to a meeting
# therefore reaches the proxy with valid credentials, with no
# separate sign-in.
#
# URL shape (the leading /proxy/ is stripped by nginx):
#
#      wss://BBB_SERVER/proxy/?sessionToken=<token>
#  or  wss://BBB_SERVER/proxy/?sessionToken=<token>&target=HOST:PORT
#
# The second form requires ALLOWED_TARGETS (a regex) to be set in
# /etc/default/bbb-wss-proxy.

import sys
import os
import re
import urllib
import urllib.request
import xml.etree.ElementTree as ET

from websockify import websocketproxy
from websockify.websocketproxy import ProxyRequestHandler

BBB_WEB_URL = os.environ.get('BBB_WEB_URL', 'http://localhost:8080')


def validate_session_token(token):
    """Return True iff bbb-web reports SUCCESS for the given session token."""
    url = '{0}/bigbluebutton/api/enter?sessionToken={1}'.format(
        BBB_WEB_URL, urllib.parse.quote(token))
    try:
        with urllib.request.urlopen(url, timeout=5) as response:
            root = ET.fromstring(response.read())
            return root.findtext('returncode') == 'SUCCESS'
    except Exception:
        return False


old_new_websocket_client = ProxyRequestHandler.new_websocket_client

allowed_targets = None


def new_websocket_client(self):
    try:
        url = urllib.parse.urlparse(self.path)
        querydict = urllib.parse.parse_qs(url.query)

        token_list = querydict.get('sessionToken')
        if not token_list:
            self.log_message('No sessionToken in query string')
            self.send_response(401, 'Unauthorized')
            self.end_headers()
            return

        if not validate_session_token(token_list[0]):
            self.log_message('Invalid BBB session token')
            self.send_response(401, 'Unauthorized')
            self.end_headers()
            return
    except Exception as ex:
        self.log_message(repr(ex))
        self.send_response(401, 'Unauthorized')
        self.end_headers()
        return

    # Use the defaults specified on the command line unless overridden by URL.
    if 'target' in querydict:
        target = querydict['target'][0]
        if allowed_targets and re.match(allowed_targets, target):
            (host, port) = target.split(':')
            self.server.target_host = host
            self.server.target_port = int(port)
        else:
            self.log_message('Requested target does not match ALLOWED_TARGETS')
            self.send_response(401, 'Unauthorized')
            self.end_headers()
            return

    # Pass through to the "parent" class's version of this method.
    old_new_websocket_client(self)


ProxyRequestHandler.new_websocket_client = new_websocket_client


if __name__ == '__main__':

    if 'SOURCE' in os.environ:
        sys.argv.append(os.environ['SOURCE'])

    if 'DEFAULT_TARGET' in os.environ:
        sys.argv.append(os.environ['DEFAULT_TARGET'])

    if 'ALLOWED_TARGETS' in os.environ:
        allowed_targets = os.environ['ALLOWED_TARGETS']

    # This calls WebSocketProxy; its default RequestHandlerClass is
    # ProxyRequestHandler, but we can't override RequestHandlerClass
    # at this point, so we settle for changing the method inside
    # ProxyRequestHandler.

    websocketproxy.websockify_init()
